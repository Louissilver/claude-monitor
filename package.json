{
  "name": "claude-monitor",
  "version": "1.0.0",
  "description": "Widget desktop para monitorar o uso do Claude (Windows e Linux/Ubuntu) — build local, foco em não vazar credenciais.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall-electron": "node node_modules/electron/install.js",
    "dist:win": "electron-builder --win nsis zip",
    "dist:linux": "electron-builder --linux deb AppImage"
  },
  "license": "MIT",
  "author": "Louissilver",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Louissilver/claude-monitor.git"
  },
  "homepage": "https://github.com/Louissilver/claude-monitor#readme",
  "bugs": {
    "url": "https://github.com/Louissilver/claude-monitor/issues"
  },
  "devDependencies": {
    "electron": "42.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.local.claude-monitor",
    "productName": "Claude Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "usage.js",
      "auth.js",
      "platform.js",
      "config.json",
      "renderer/**"
    ],
    "win": {
      "target": ["nsis", "zip"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Utility",
      "maintainer": "Louissilver",
      "synopsis": "Widget desktop que monitora o uso do Claude",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "depends": ["libnotify4", "libsecret-1-0"]
    }
  }
}
